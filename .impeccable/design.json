      "html": "<button class=\"ds-primary ds-focus\">继续研习 <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button>",
      "css": ".ds-primary{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;display:inline-flex;align-items:center;gap:16px;padding:11px 20px;background:var(--green,#244f46);color:#f4f8f1;border:1px solid transparent;border-radius:7px;font-size:12px;line-height:1.7;font-weight:500}.ds-primary:hover{background:#346555;color:#fff;box-shadow:0 4px 14px #244f4617}.ds-primary:disabled{opacity:.48;cursor:default}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Inverse Button",
      "kind": "button",
      "refersTo": "button-inverse",
      "description": "深松绿面板中的浅叶绿行动。",
      "html": "<div class=\"ds-inverse-surface\"><button class=\"ds-inverse ds-focus\">开始第一个知识点 <svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></button></div>",
      "css": ".ds-inverse-surface{background:var(--green,#244f46);padding:25px;border-radius:14px}.ds-inverse{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;display:inline-flex;align-items:center;gap:16px;background:#e5eddb;color:#2e5545;border:1px solid transparent;border-radius:7px;padding:10px 18px;font-size:11px;line-height:1.7;font-weight:500}.ds-inverse:hover{background:#f1f5e9}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "导入导出、提示与自评等次行动。",
      "html": "<button class=\"ds-secondary ds-focus\">导出学习记录</button>",
      "css": ".ds-secondary{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;display:inline-flex;align-items:center;gap:9px;border:1px solid #d5e0cf;background:#fff;padding:9px 15px;border-radius:7px;font-size:11px;color:#5d7b52}.ds-secondary:hover{background:#eef5e6;border-color:#aabc9d}.ds-secondary:disabled{opacity:.48;cursor:default}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Search Field",
      "kind": "input",
      "refersTo": "search-field",
      "description": "目录中的白色描边搜索输入。",
      "html": "<label class=\"ds-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 5 5\"/></svg><input class=\"ds-search-input ds-focus\" aria-label=\"搜索知识点\" placeholder=\"搜索知识点、公式条件或题号\"/></label>",
      "css": ".ds-search{display:flex;gap:12px;align-items:center;padding:13px 17px;border:1px solid #dce5da;border-radius:9px;background:#fff;color:#62735e}.ds-search-input{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;border:0;background:none;flex:1;min-width:0;width:100%;font-size:12px;color:var(--ink,#253b35);caret-color:var(--green,#244f46)}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Directory Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "当前页面以浅绿底和较深字重定位。",
      "html": "<nav class=\"ds-nav\" aria-label=\"主导航示例\"><a class=\"ds-focus\" href=\"#library\" aria-current=\"page\">知识目录</a><a class=\"ds-focus\" href=\"#labs\">交互实验</a></nav>",
      "css": ".ds-nav{background:#f0f4ef;padding:16px}.ds-nav a{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;display:flex;align-items:center;gap:13px;padding:11px 13px;border-radius:8px;font-size:13px;color:#637568;text-decoration:none}.ds-nav a[aria-current]{background:#dfe9dc;color:#244f3d;font-weight:600}.ds-nav a:hover{background:#e4ece0}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Subject Filter",
      "kind": "chip",
      "refersTo": "filter-selected",
      "description": "目录中的紧凑学科筛选。",
      "html": "<div class=\"ds-filters\"><button class=\"ds-filter ds-focus\" aria-pressed=\"true\">全部 <span>70</span></button><button class=\"ds-filter ds-focus\" aria-pressed=\"false\">线性代数 <span>18</span></button></div>",
      "css": ".ds-filters{display:flex;gap:5px}.ds-filter{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;display:flex;gap:8px;align-items:center;font-size:11px;padding:7px 12px;border:0;border-radius:6px;color:#62735e;background:none}.ds-filter[aria-pressed=true]{background:#e4ecdf;color:#38583e;font-weight:500}.ds-filter:hover{background:#edf2e9}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Continue Panel",
      "kind": "card",
      "refersTo": "continue-panel",
      "description": "当前单元的标题、上下文、识别信号与主行动。",
      "html": "<section class=\"ds-continue\"><h2>等价无穷小替换</h2><span>从一个好问题开始</span><p>先读出题面结构，再选择合适的方法。</p><button class=\"ds-continue-action ds-focus\">开始第一个知识点 →</button><small>微积分 · 5 个学习环节 · 含完整真题</small></section>",
      "css": ".ds-continue{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;background:var(--green,#244f46);color:#eff5ed;border-radius:14px;padding:30px 35px}.ds-continue h2{font-weight:600;line-height:1.45;margin:0}.ds-continue>span{display:block;color:#c0d5c3;margin-top:8px}.ds-continue p{color:#c0d2c6;margin:12px 0 0}.ds-continue small{display:block;color:#bfd2c1;margin-top:14px}.ds-continue-action{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;cursor:pointer;transition:background .18s,color .18s,box-shadow .18s;margin-top:23px;background:#e5eddb;color:#2e5545;border:1px solid transparent;border-radius:7px;padding:10px 18px;font-size:11px;line-height:1.7}.ds-continue-action:hover{background:#f1f5e9}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Reflection Field",
      "kind": "input",
      "description": "有可见标签、足够行高的长回答输入。",
      "html": "<label class=\"ds-reflection\">用自己的话，重建这条思路<textarea class=\"ds-focus\" rows=\"4\" placeholder=\"我注意到的结构是……\"></textarea></label>",
      "css": ".ds-reflection{display:block;font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;font-size:11px;color:#62735e}.ds-reflection textarea{display:block;width:100%;box-sizing:border-box;padding:14px;background:#fff;border:1px solid #d8e3cf;border-radius:7px;margin-top:9px;color:#4e6a3e;font-family:inherit;font-size:12px;line-height:1.9;resize:vertical;caret-color:var(--green,#244f46)}.ds-focus:focus-visible{outline:3px solid #86a992;outline-offset:4px}"
    },
    {
      "name": "Reading Preferences",
      "kind": "custom",
      "refersTo": "reading-settings",
      "description": "配对浅色/深色语义表面的阅读设置；提供外观、四档字号和 Zen 入口。",
      "html": "<section class=\"ds-reading\"><h2>阅读设置</h2><h3>外观</h3><div class=\"ds-reading-options\"><button aria-pressed=\"true\">浅色</button><button aria-pressed=\"false\">深色</button><button aria-pressed=\"false\">跟随系统</button></div><div class=\"ds-reading-label\"><h3>文字大小</h3><output>100%</output></div><div class=\"ds-reading-options\"><button aria-pressed=\"true\">标准</button><button aria-pressed=\"false\">舒适</button><button aria-pressed=\"false\">大号</button><button aria-pressed=\"false\">特大</button></div><p>正文、公式和练习会一起缩放。</p><div class=\"ds-reading-zen\"><h3>Zen 专注模式</h3><p>收起辅助界面，正文默认大一号。</p><button>进入</button></div></section>",
      "css": ".ds-reading{font-family:'Noto Sans SC Variable','Microsoft YaHei',sans-serif;width:308px;max-width:calc(100vw - 32px);padding:20px;background:var(--panel,#fff);color:var(--reading-ink,#253b35);border:1px solid var(--reading-border,#dce5da);border-radius:12px;box-shadow:var(--reading-shadow,0 12px 34px #213d291c)}.ds-reading h2{font-size:15px;font-weight:600;margin:0}.ds-reading h3{font-size:11px;font-weight:500;margin:20px 0 0}.ds-reading-options{display:flex;gap:5px;margin-top:10px}.ds-reading-options button{flex:1;display:flex;align-items:center;justify-content:center;font:inherit;font-size:11px;padding:9px 5px;min-height:38px;border:0;border-radius:6px;color:var(--reading-muted,#607066);background:var(--panel-soft,#edf2ec);cursor:pointer}.ds-reading-options button[aria-pressed=true]{background:var(--reading-active,#244f46);color:var(--reading-on-active,#fff)}.ds-reading button:hover{filter:brightness(.97)}.ds-reading button:focus-visible{outline:3px solid var(--reading-focus,#86a992);outline-offset:4px}.ds-reading-label{display:flex;align-items:baseline;justify-content:space-between}.ds-reading output,.ds-reading p{font-size:10px;color:var(--reading-muted,#607066);line-height:1.8}.ds-reading output{font-variant-numeric:tabular-nums}.ds-reading-zen{border-top:1px solid var(--reading-border,#dce5da);margin-top:21px}.ds-reading-zen button{font:inherit;font-size:11px;color:var(--reading-active,#244f46);background:none;border:0;cursor:pointer}"
    }
  ],
  "narrative": {
    "northStar": "大学出版社的学科目录",
    "overview": "界面以冷白纸面、深松绿、低饱和灰绿和精确细线建立秩序。中文内容保持安静，目录、公式、学习步骤和留白承担主要层级；小型函数图与学科符号帮助定位内容。\n\n现代、美观、含蓄收敛是稳定的品牌约束。界面应支持连续阅读和主动推演，让状态清晰、入口明确，装饰服从学习内容。",
    "keyCharacteristics": [
      "冷白纸面与深松绿主行动。",
      "有编号、分级、细线的目录秩序。",
      "数学符号与小型函数图构成学科气质。",
      "扁平内容区、克制圆角与局部浮层。"
    ],
    "rules": [
      {
        "name": "The Quiet Accent Rule",
        "body": "持续阅读区域保持冷白和墨色，深松绿留给明确的行动、选中状态和少量重点表面。",
        "section": "colors"
      },
      {
        "name": "The Formula Fidelity Rule",
        "body": "数学表达式保持 KaTeX 渲染、原有条件与必要的横向滚动空间。",
        "section": "typography"
      },
      {
        "name": "The Local Elevation Rule",
        "body": "阴影用于确实浮在页面之上的临时界面与轻微行动反馈。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 使用目录行、编号和细线建立阅读顺序。",
      "Do 为深色表面采用浅色文字及反色行动按钮。",
      "Do 保留公式、完整题干与来源信息的阅读空间。",
      "Do 同时用文字、图标或形状表达状态。"
    ],
    "donts": [
      "Don't 把每一段教学内容都装进有阴影的卡片。",
      "Don't 用高饱和装饰取代含蓄的冷白与灰绿秩序。",
      "Don't 为装饰性图形压缩手机正文或截断公式与表格。",
      "Don't 将自评进度表现成已验证的能力认证。"
    ]
  }
}
